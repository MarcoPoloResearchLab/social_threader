{
  "expo": {
    "name": "Social Threader",
    "slug": "social-threader-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "socialthreader",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0063b9"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Social Threader lets you attach selected images as thread chunks.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-ios-release"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mprlab.threader",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mprlab.socialthreader",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0063b9"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
