{
  "name": "social-threader-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Universal iOS and Android app for Social Threader.",
  "main": "index.js",
  "scripts": {
    "sync-shared": "node scripts/sync-shared-web.mjs",
    "prestart": "npm run sync-shared",
    "start": "expo start",
    "preandroid": "npm run sync-shared",
    "android": "node scripts/android-run.mjs",
    "preios": "npm run sync-shared",
    "ios": "node scripts/ios-run.mjs",
    "preweb": "npm run sync-shared",
    "web": "expo start --web",
    "pretest": "npm run sync-shared",
    "test": "jest --watchman=false --runInBand",
    "pretest:coverage": "npm run sync-shared",
    "test:coverage": "jest --watchman=false --runInBand --coverage",
    "bundle:check": "node scripts/validate-bundle.mjs",
    "check": "npm run sync-shared && npm run test:coverage && node scripts/validate-config.mjs && npx --no-install expo config --type public >/dev/null && npx --no-install expo install --check && npm run bundle:check",
    "prepare:ios": "node scripts/prepare-ios.mjs",
    "verify:ios": "node scripts/verify-ios-preparation.mjs",
    "prepare:android": "node scripts/prepare-android.mjs",
    "verify:android": "node scripts/verify-android-preparation.mjs",
    "test:android-build": "node --test scripts/android-build.integration.mjs"
  },
  "dependencies": {
    "expo": "57.0.31",
    "expo-clipboard": "57.0.2",
    "expo-image-picker": "57.0.20",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "babel-jest": "30.4.1",
    "babel-preset-expo": "57.0.5",
    "jest": "30.4.1",
    "test-renderer": "1.2.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native/metro-config": "0.86.3"
  },
  "overrides": {
    "@jest/reporters": {
      "glob": "13.0.6"
    },
    "babel-plugin-istanbul": "8.0.0",
    "jest-config": {
      "glob": "13.0.6"
    },
    "jest-runtime": {
      "glob": "13.0.6"
    },
    "test-exclude": "8.0.0",
    "xcode": {
      "uuid": "11.1.0"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "jest"
      ]
    }
  }
}
